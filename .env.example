# Copy to .env and fill in. Never commit .env.
#
# LocalStack auth token. Required only if you use a Pro/licensed image.
# The default community image works without it.
LOCALSTACK_AUTH_TOKEN=

# Optional: override the LocalStack image. Fallback if the pinned tag misbehaves:
#   LOCALSTACK_IMAGE=localstack/localstack
LOCALSTACK_IMAGE=localstack/localstack:3.8

# Fake AWS credentials. LocalStack ignores the values but the SDK/CLI need them set.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# Endpoint used by the CLI, Terraform, and the demo/scripts.
AWS_ENDPOINT_URL=http://localhost:4566
